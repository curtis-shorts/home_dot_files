# This file contains fish universal variable definitions.
# VERSION: 3.0
switch (uname)
    case Darwin
        SETUVAR __fish_initialized:4300
        SETUVAR fish_user_paths:/Users/cushorts/\x2elocal/bin
    case Linux
        SETUVAR __fish_initialized:3400
        SETUVAR fish_key_bindings:fish_default_key_bindings
        SETUVAR fish_user_paths:/home/cushorts/\x2elocal/bin\x1e/Users/cushorts/\x2elocal/bin
end

